{
    "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
    "root": true,
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on",
                "useSortedAttributes": "off",
                "useSortedKeys": "off"
            }
        },
        "enabled": true
    },
    "css": {
        "formatter": {
            "enabled": true
        },
        "linter": {
            "enabled": true
        },
        "parser": {
            "cssModules": true
        }
    },
    "formatter": {
        "attributePosition": "auto",
        "bracketSameLine": true,
        "bracketSpacing": true,
        "enabled": true,
        "expand": "auto",
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "single",
            "jsxQuoteStyle": "single"
        }
    },
    "files": {
        "includes": [
            "*",
            "**",
            "!!**/temp",
            "!!**/dist",
            "!!**/functions/lib",
            "!!**/node_modules",
            "!!**/.cache",
            "!!**/.gemini",
            "!!**/.agents/scratch"
        ]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "a11y": {
                "useMediaCaption": "off",
                "noStaticElementInteractions": "off",
                "useKeyWithClickEvents": "off",
                "noSvgWithoutTitle": "off"
            },
            "performance": {
                "noDynamicNamespaceImportAccess": "off",
                "noImgElement": "off"
            },
            "correctness": {
                "noUnusedFunctionParameters": "error",
                "noUnusedVariables": "error",
                "useImportExtensions": "error",
                "useExhaustiveDependencies": "off",
                "useHookAtTopLevel": "error",
                "useParseIntRadix": "off"
            },
            "complexity": {
                "useLiteralKeys": "off"
            },
            "style": {
                "noHeadElement": "off",
                "noEnum": "error",
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "filenameCases": ["camelCase", "export"],
                        "match": "%?(.+?)[.](.+)",
                        "requireAscii": true,
                        "strictCase": false
                    }
                },
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false
                    }
                }
            },
            "suspicious": {
                "noDoubleEquals": "error",
                "noExplicitAny": "error"
            },
            "security": {
                "noDangerouslySetInnerHtml": "off"
            }
        },
        "includes": [
            "*",
            "**",
            "!!**/temp/**",
            "!!**/dist/**",
            "!!**/functions/lib/**",
            "!!**/node_modules/**",
            "!!**/.cache/**",
            "!!**/.gemini/**",
            "!!**/.agents/scratch/**"
        ]
    },
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    }
}
