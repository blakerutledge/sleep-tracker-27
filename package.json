{
  "name": "sleep-tracker-27",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test": "bun test",
    "typecheck": "bunx --bun tsc --noEmit",
    "deploy": "bun --bun vite build && bunx --bun firebase-tools deploy",
    "deploy:hosting": "bun --bun vite build && bunx --bun firebase-tools deploy --only hosting",
    "deploy:rules": "bunx --bun firebase-tools deploy --only firestore:rules"
  },
  "dependencies": {
    "@microsoft/focusgroup-polyfill": "^1.6.0",
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
