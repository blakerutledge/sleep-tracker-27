{
    "extensions.ignoreRecommendations": false,
    "[json]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnType": false
    },
    "[jsonc]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnType": false
    },
    "[html]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnType": false
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome",
        "js/ts.preferences.importModuleSpecifierEnding": "auto",
        "editor.formatOnType": false
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome",
        "js/ts.preferences.importModuleSpecifierEnding": "auto",
        "editor.formatOnType": false
    },
    "[javascript]": {
        "editor.defaultFormatter": "biomejs.biome",
        "js/ts.preferences.importModuleSpecifierEnding": "auto",
        "editor.formatOnType": false
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "biomejs.biome",
        "js/ts.preferences.importModuleSpecifierEnding": "auto",
        "editor.formatOnType": false
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[scss]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "editor.codeActionsOnSave": {
        "source.action.useSortedAttributes.biome": "never",
        "source.action.useSortedKeys.biome": "never",
        "source.fixAll.biome": "explicit",
        "source.organizeImports.biome": "explicit"
    },
    "npm.packageManager": "bun",
    "editor.codeLens": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnPaste": false,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "editor.tabSize": 4,
    "files.eol": "\n",
    "search.exclude": {
        "**/node_modules": true,
        "**/.venv": true,
        "**/.git": true
    },
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/.git/index": true,
        "**/.git/index.lock": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.venv/**": true,
        "**/.vendor/**": true,
        "**/.ruff_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.next/**": true,
        "**/dist/**": true,
        "**/.cache/**": true,
        "**/.terraform/**": true,
        "**/.gcloud/**": true,
        "**/.gemini/**": true,
        "**/__pycache__/**": true
    },
    "telemetry.telemetryLevel": "off",
    "files.exclude": {
        "**/.next": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/__init__.py": false,
        "**/*.lock": true,
        "**/bun.lockb": true,
        "**/dist": true,
        "**/node_modules": true,
        "**/sw.js": true,
        "**/sw.js.map": true,
        "**/workbox-*.js": true,
        "**/workbox-*.js.map": true,
        "**/*.tsbuildinfo": true,
        "**/.ruff_cache": true,
        "**/typings": true,
        "**/firebase-debug.log": true,
        "**/firestore-debug.log": true,
        "**/*.egg-info": true,
        ".vendor/": true,
        ".husky/": true,
        ".vscode/": true,
        ".npmrc": true,
        "bunfig.toml": true,
        ".gcloud": true,
        "**/.terraform": true,
        "**/.pytest_cache": true,
        "**/.terraform.lock.hcl": true,
        ".github": false,
        "docs/agents/rules": true,
        "docs/agents/skills": true
    },
    "files.associations": {
        "*.json": "json"
    },
    "terminal.integrated.sendKeybindingsToShell": true,
    "mise.checkForNewMiseVersion": false,
    "mise.configureExtensionsAutomaticallyIgnoreList": ["biomejs.biome"],
    "mise.configureExtensionsUseShims": false,
    "mise.configureExtensionsUseSymLinks": true,
    "js/ts.preferences.importModuleSpecifierEnding": "auto",
    "js/ts.tsdk.path": "./node_modules/typescript/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "js/ts.validate.enabled": true,
    "typescript.preferences.importModuleSpecifierEnding": "auto",
    "javascript.preferences.importModuleSpecifierEnding": "auto",
    "typescript.tsdk": "./node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.validate.enable": true,
    "terminal.integrated.splitCwd": "workspaceRoot",
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "[markdown]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
    },
    "biome.suggestInstallingGlobally": false,
    "biome.requireConfiguration": true,
    "git.autorefresh": true,
    "git.autofetch": true,
    "workbench.browser.openLocalhostLinks": false,
    "explorer.autoReveal": false
}
